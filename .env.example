# DataPilot-AI Environment Configuration Example
# Copy this file to .env for local development:
# cp .env.example .env

# App Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Database Setup (Defaults to SQLite for local development)
# SQLite default: sqlite:///./datapilot.db
# PostgreSQL example: postgresql://user:password@localhost:5432/datapilot_db
DATABASE_URL=sqlite:///./datapilot.db

# Storage Paths
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=150
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=150

# Server & Host Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=*

OPEN_ROUTER=#
MODEL_NAME=#
# AI Agent LLM Keys & Dynamic Model Choice (Never hardcoded in python)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL_NAME=gemini-3.5-flash-lite
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=30


# ── Supabase Cloud Storage Configuration ──
STORAGE_BACKEND=supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET=datasets

# ── Memory-Safe ML Sampling Limit ──
MAX_ML_SAMPLE_ROWS=50000

DATABASE_URL=postgresql://postgres:your_password@db.keedragqsfqvshognlgg.supabase.co:5432/postgres
